    given-names: "Marco"
    affiliation: "CROW"
version: "1.0.0"
date-released: "2026-10-04"
repository-code: "https://github.com/Marrekoo/IKOB_Aporometrica"
license: MIT
keywords:
  - accessibility
  - transport equity
  - survival analysis
  - shared bicycles
